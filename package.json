{
    "name": "latex-formatter",
    "displayName": "latex-formatter",
    "description": "Simple LaTex formatter.",
    "icon": "img/icon.png",
    "version": "1.0.5",
    "publisher": "nickfode",
    "repository": {
        "type": "git",
        "url": "https://github.com/nfode/latex-formatter"
    },
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Other",
        "Formatters"
    ],
    "activationEvents": [
        "onLanguage:latex"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "languages": [
            {
                "id": "latex",
                "aliases": [
                    "tex"
                ]
            }
        ],
        "capabilities": {
            "documentFormattingProvider": "true"
        },
        "commands": [
            {
                "command": "extension.sayHello",
                "title": "Hello World"
            }
        ]
    },
    "scripts": {
        "esbuild": "node esbuild.js",
        "vscode:prepublish": "node esbuild.js --minify",
        "package": "npm run vscode:prepublish && npx @vscode/vsce package",
        "test": "tsc -p ./ && node ./out/test/runTest.js"
        
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@types/vscode": "^1.146.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.0",
        "esbuild": "^0.28.2",
        "glob": "^14.0.6",
        "mocha": "^12.0.3",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "@vscode/vsce-sign@2.1.0": true
    }
}
